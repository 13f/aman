%% ============================================================================
%% 10. Admission Pipeline — Trust & Rate Limiting → Backpressure → Dedup
%% ============================================================================

flowchart TD
    PUBLISH(["publish(event)"]):::start --> TL{"Layer 4a: Trust<br/>Sandboxed source +<br/>sensitive type?"}
    TL -->|"Yes"| REJECT["❌ Reject<br/>SecurityViolation"]:::reject
    TL -->|"No"| RL{"Layer 4b: Rate Limit<br/>Per-source token bucket<br/>exceeded?"}
    RL -->|"Yes"| RATE_ERR["❌ RateLimited"]:::reject
    RL -->|"No"| BP{"Backpressure<br/>7-level check"}
    BP -->|"Idle event + L1+"| DROP_IDLE["Drop (silent)<br/>idle_events_discarded++"]:::drop
    BP -->|"Critical + Low"| DROP_LOW["Drop Low Priority"]:::drop
    BP -->|"L2+ AtMostOnce"| DROP_AMO["Drop AtMostOnce"]:::drop
    BP -->|"L3+ Guaranteed"| BLOCK["Block<br/>RetryLater(L3)"]:::block
    BP -->|"L4A Guaranteed"| OFLOW["Overflow to Disk<br/>.json files"]:::overflow
    BP -->|"L4A + ≥80% overflow"| EMERG["OverflowDirEmergency<br/>→ RetryLater(L3)"]:::block
    BP -->|"Normal / accepted"| DEDUP{"Dedup Window<br/>Bloom + LRU<br/>30s window"}
    DEDUP -->|"Duplicate"| DUP["Drop (silent)<br/>duplicate_count++"]:::drop
    DEDUP -->|"Accepted"| QUEUE["Enqueue<br/>OrderedQueue<br/>notify waiters"]:::accept
    QUEUE --> DISPATCH["Dispatch to<br/>matching subscribers"]:::accept

