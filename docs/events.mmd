%% ============================================================================
%% 2. Event Flow Architecture
%% ============================================================================

flowchart TD
    subgraph Sources["Event Sources"]
        FS[FileWatchSource<br/>file_watch.rs]
        Timer[TimerSource<br/>timer.rs]
        Cron[CronSource<br/>cron.rs]
        WS[WebhookSource<br/>webhook.rs]
        Signal[SignalSource<br/>signal.rs]
        Socket[SocketSource<br/>socket.rs]
        Chat[ChatPlatformSource<br/>chat-source/lib.rs]
    end

    subgraph Bus["Event Bus (InMemoryBus / PersistentBus)"]
        EB[EventBus<br/>publish / subscribe]
        BP[Backpressure<br/>L1 L2 L3 L4A L4B]
        DD[Dedup]
        OV[Overflow-to-Disk]
        RQ[RetryQueue]
    end

    subgraph Subscribers["Core Subscribers"]
        SA[StoreAllEventsHandler<br/>→ EventStore<br/>agent_runtime.rs:903]
        SD[SkillEventDispatcher<br/>→ skill matching<br/>→ message:dispatch/completed<br/>agent_runtime.rs:422]
        LP[LLMPlugin<br/>→ MessageReceived<br/>→ llm:call_started/ended<br/>llm-plugin/lib.rs:342]
    end

    subgraph Producers["Custom Event Producers"]
        GW[Gateway Daemon<br/>main.rs<br/>gateway:start/ready/stop]
        HTTP[HTTP Handlers<br/>http.rs<br/>session:started/closed]
        CR[CapabilityRegistry<br/>agent_runtime.rs:833<br/>capability_*]
        SX[SoulRuntime<br/>soul/lib.rs:384<br/>soul_changed]
        WE[WorkflowEngine<br/>workflow/lib.rs<br/>retry / cancel]
    end

    subgraph Storage["Storage & Observability"]
        ES[(EventStore<br/>in-memory ring buffer)]
        DLQ[(Dead Letter Queue<br/>persistence/dlq.rs)]
        AL[(Audit Log<br/>audit.rs)]
        DP[Debug Panel<br/>Tauri frontend]
    end

    Sources -->|poll + publish| EB
    EB -->|route by filter| Subscribers
    Producers -->|publish_event| EB
    WE -->|handle_event| Subscribers
    SA -->|record all| ES
    SD -->|message:dispatch/completed| EB
    LP -->|llm:call_started/ended| EB
    ES --> DP
    EB -->|failed delivery| DLQ

    style EB fill:#4a6b8a,color:#fff
    style Subscribers fill:#2d5a3d,color:#fff
    style Storage fill:#5a3d2d,color:#fff

%% ============================================================================
%% 3. Trace Chain Flow
%% ============================================================================

flowchart LR
    subgraph TraceChain["Trace Chain (trace_id + parent_event_id)"]
        direction LR
        MSG[MessageReceived<br/>trace_id: T]
        DISPATCH[message:dispatch<br/>trace_id: T<br/>parent: MSG.id]
        CALL[llm:call_started<br/>trace_id: T<br/>parent: DISPATCH.id]
        REPLY[llm:call_ended<br/>trace_id: T<br/>parent: CALL.id]
        COMPLETE[message:completed<br/>trace_id: T<br/>parent: REPLY.id]
    end

    MSG --> DISPATCH --> CALL --> REPLY --> COMPLETE

    style MSG fill:#4a6b8a,color:#fff
    style DISPATCH fill:#6a8a4a,color:#fff
    style CALL fill:#8a6a4a,color:#fff
    style REPLY fill:#8a4a6a,color:#fff
    style COMPLETE fill:#4a8a6a,color:#fff

%% ============================================================================
%% 4. Chat Session Workflow State Machine
%% ============================================================================

stateDiagram-v2
    [*] --> ACTIVE: session created

    ACTIVE --> PROCESSING: MESSAGE_RECEIVED
    ACTIVE --> TIMEOUT: SESSION_TIMEOUT (300s)

    PROCESSING --> IDLE: LLM_REPLY_READY / LLM_STREAM_DONE
    PROCESSING --> ERROR: LLM_ERROR
    PROCESSING --> TIMEOUT: STREAM_TIMEOUT (120s)
    PROCESSING --> CLOSED: SESSION_CLOSE_CMD

    IDLE --> PROCESSING: MESSAGE_RECEIVED
    IDLE --> TIMEOUT: SESSION_TIMEOUT (600s)
    IDLE --> CLOSED: SESSION_END

    ERROR --> RETRYING: RETRY_CMD
    ERROR --> IDLE: SESSION_END
    ERROR --> CLOSED: ABANDON_TIMEOUT (120s)

    RETRYING --> PROCESSING: RETRY_STARTED
    RETRYING --> ERROR: RETRY_FAILED

    TIMEOUT --> CLOSED: SESSION_END
    TIMEOUT --> IDLE: MESSAGE_RECEIVED

    note right of ACTIVE: Initial session state
    note right of PROCESSING: LLM is generating
    note right of IDLE: Waiting for next message
    note right of ERROR: Needs retry or cancel
    note right of RETRYING: Auto/manual retry in progress
    note right of TIMEOUT: Session timed out

