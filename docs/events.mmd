    participant LocalB as Local Bus (coder)

    Main->>Main: AgentRuntimeBuilder::build()
    Runtime->>Global: create(InMemoryBusConfig { max_queue_size: 10000 })
    Runtime->>Runtime: create PluginLoader, SkillRegistry, ToolRegistry
    Runtime->>Registry: AgentRegistry::new(global_bus)
    Runtime->>Runtime: create AgentHarness(registry, global_bus, ...)
    Runtime->>Global: subscribe: StoreAllEvents, SkillDispatcher, etc.

    Main->>Main: runtime.start() — Phase 0 to Phase 5
    Main->>Global: publish(gateway:starting)

    Note over Runtime,Registry: Phase 2: load agents from config

    loop AmanConfig.agents.each()
        alt agent has event_bus config
            Registry->>LocalA: InMemoryBus::new(max_queue_size: 2000)
        else agent without config
            Registry->>LocalB: InMemoryBus::new(max_queue_size: 1000, default)
        end
        Registry->>Registry: set_local_bus(agent_id, bus)
        Registry->>Global: publish(agent:registered, {agent_id})
    end

    Main->>Global: publish(gateway:ready)

    Note over Main,LocalB: Runtime ready — each agent's Local Bus handles<br/>internal events independently of other agents
