%% ============================================================================
%% 5. Chat-Session Workflow State Machine
%% ============================================================================

stateDiagram-v2
    [*] --> ACTIVE: session created

    state ACTIVE {
        [*] --> waiting
        waiting --> dispatching: MESSAGE_RECEIVED
    }

    state PROCESSING {
        [*] --> llm_call
        llm_call --> tool_exec: LLM requests tools
        tool_exec --> llm_call: tool results ready
        llm_call --> streaming: LLM streams response
        streaming --> done: stream completes
    }

    ACTIVE --> PROCESSING: MESSAGE_RECEIVED
    ACTIVE --> TIMEOUT: SESSION_TIMEOUT (300s)

    PROCESSING --> IDLE: LLM_REPLY_READY
    PROCESSING --> IDLE: LLM_STREAM_DONE
    PROCESSING --> ERROR: LLM_ERROR
    PROCESSING --> TIMEOUT: STREAM_TIMEOUT (120s)
    PROCESSING --> CLOSED: SESSION_CLOSE_CMD

    IDLE --> PROCESSING: MESSAGE_RECEIVED
    IDLE --> TIMEOUT: SESSION_TIMEOUT (600s)
    IDLE --> CLOSED: SESSION_END

    ERROR --> RETRYING: RETRY_CMD
    ERROR --> IDLE: SESSION_END
    ERROR --> CLOSED: ABANDON_TIMEOUT (120s)

    RETRYING --> PROCESSING: RETRY_STARTED
    RETRYING --> ERROR: RETRY_FAILED

    TIMEOUT --> CLOSED: SESSION_END
    TIMEOUT --> IDLE: MESSAGE_RECEIVED

    CLOSED --> [*]
    TIMEOUT --> [*]

    note right of PROCESSING
        During PROCESSING:
        • llm:* → Local Bus (isolated)
        • tool:* → Local Bus (isolated)
        • agent:reply_stream_* → Local Bus
        • agent:got_tool_calls → Local Bus
    end note

    note left of ACTIVE
        Lifecycle events → Global Bus:
        • agent:busy (on dispatch)
        • agent:idle (on complete)
        • agent:reply_ready (final response)
    end note

%% ============================================================================
%% 5a. Work System State Machine
%% ============================================================================

stateDiagram-v2
    [*] --> IDLE: WorkSystem initialized

    state IDLE {
        [*] --> waiting_for_tick
        waiting_for_tick --> cooldown_check: TaskBoardUpdated / WorkTick
    }

    state CHECKING {
        [*] --> query_board
        query_board --> select_task: tasks available
        query_board --> no_tasks: no tasks
    }

    state CLAIMING {
        [*] --> send_claim
        send_claim --> wait_response
    }

    state EXECUTING {
        [*] --> run_step
        run_step --> run_step: StepComplete + more steps
        run_step --> all_done: last step complete
        run_step --> retry: StepFailed (retryable)
    }

    state REVIEWING {
        [*] --> verify
        verify --> pass: passed
        verify --> fail: failed
    }

    IDLE --> CHECKING: cooldown passed
    IDLE --> IDLE: cooldown not elapsed (ignore)

    CHECKING --> CLAIMING: task selected
    CHECKING --> IDLE: no tasks → schedule DelayedWorkTick

    CLAIMING --> EXECUTING: ClaimResponse(success=true)
    CLAIMING --> IDLE: ClaimResponse(success=false) → frustration + backoff

    EXECUTING --> REVIEWING: all steps complete
    EXECUTING --> IDLE: StepFailed (non-retryable)

    REVIEWING --> IDLE: ReviewComplete → SubmitResult + IdleSignal
    REVIEWING --> IDLE: ReviewComplete(passed=false) → SubmitResult(failed)

    IDLE --> [*]: shutdown
    CHECKING --> IDLE: Interrupt (save checkpoint)
    CLAIMING --> IDLE: Interrupt (save checkpoint)
    EXECUTING --> IDLE: Interrupt (save checkpoint)
    REVIEWING --> IDLE: Interrupt (save checkpoint)

    note right of EXECUTING
        Chain delivery keeps Bus non-empty:
        ExecuteStep(0) → StepComplete →
        ExecuteStep(1) → StepComplete → ...
        → ReviewTask → ReviewComplete →
        WorkCycleDone → DelayedWorkTick
    end note

    note left of IDLE
        IDLE = Bus empty
        → Idle System runs (Daze → Boredom → ...)

        Scheduler sends Interrupt to
        switch subsystems (Work → Study)
    end note

