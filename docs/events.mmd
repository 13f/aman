%% ============================================================================

flowchart TD
    START(["Event to publish"]) --> Q1{"Event category?"}

    Q1 -->|"🌐 Gateway lifecycle<br/>(gateway:*)"| GLOBAL
    Q1 -->|"🌐 Agent lifecycle<br/>(agent:registered, busy, idle, reply_ready)"| GLOBAL
    Q1 -->|"🌐 Agent final response<br/>(agent:reply_ready, agent:reply_interrupted)"| GLOBAL
    Q1 -->|"🌐 Cross-agent message<br/>(agent:message)"| GLOBAL
    Q1 -->|"🌐 Session<br/>(session:started, session:closed)"| GLOBAL
    Q1 -->|"🌐 Config / Skill<br/>(ConfigChanged, SkillReloaded)"| GLOBAL
    Q1 -->|"🌐 Source events<br/>(FileCreated, CronTick, etc.)"| GLOBAL
    Q1 -->|"🌐 Message dispatch<br/>(message:dispatch, message:completed)"| GLOBAL
    Q1 -->|"🌐 Capability<br/>(capability_*)"| GLOBAL

    Q1 -->|"🔒 LLM calls<br/>(llm:call_started, llm:call_ended, llm_error)"| LOCAL
    Q1 -->|"🔒 Streaming<br/>(agent:reply_stream_*)"| LOCAL
    Q1 -->|"🔒 Tool execution<br/>(tool:dispatched, completed, failed, security_denied)"| LOCAL
    Q1 -->|"🔒 Token tracking<br/>(agent:token_used)"| LOCAL
    Q1 -->|"🔒 ReAct internals<br/>(agent:got_tool_calls, history_compressed, etc.)"| LOCAL

    GLOBAL["🌐 Global Bus"]:::globalNode
    LOCAL["🔒 Local Bus"]:::localNode

    GLOBAL --> RESOLVE{"AgentRegistry<br/>has Local Bus<br/>for this agent_id?"}
    RESOLVE -->|"Yes"| PUBLISH_LOCAL["publish to<br/>agent's Local Bus"]:::localNode
    RESOLVE -->|"No (single-agent<br/>fallback)"| PUBLISH_GLOBAL["publish to<br/>Global Bus"]:::globalNode

    LOCAL --> PUBLISH_LOCAL

    PUBLISH_LOCAL --> DONE(["✓ Backpressure scope: single agent"])
    PUBLISH_GLOBAL --> DONE(["✓ Backpressure scope: system-wide"])

