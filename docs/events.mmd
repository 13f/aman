%% ============================================================================
%% 2. Dual-Layer Event Bus Architecture
%% ============================================================================

flowchart TB
    subgraph SOURCES["Event Sources"]
        direction LR
        S1["Timer / Cron"]:::source
        S2["FileWatch"]:::source
        S3["Webhook / Signal"]:::source
        S4["Chat Platform"]:::source
        S5["Config / HotReload"]:::source
    end

    subgraph GLOBAL["🌐 Global Event Bus"]
        G1["max_queue_size: 10000<br/>7-level backpressure<br/>Trust-level enforcement<br/>Per-source rate limiter"]:::global
    end

    subgraph CORE["Core Subscribers (Global Bus)"]
        direction TB
        C1["StoreAllEventsHandler → EventStore"]:::subscriber
        C2["SkillEventDispatcher → Skill matching"]:::subscriber
        C3["ScriptHookEventHandler → Script Hooks"]:::subscriber
        C4["NotificationSubscriber → Notifications"]:::subscriber
        C5["StopGenerationHandler → STOP_GENERATION"]:::subscriber
        C6["MessageReceivedHandler → AgentHarness"]:::subscriber
        C7["AgentMessageHandler → agent:message routing"]:::subscriber
        C8["TrustEnforcement → reject sandboxed sensitive"]:::subscriber
        C9["RateLimiter → per-source token bucket"]:::subscriber
    end

    subgraph AGENTS[" "]
        direction LR
        subgraph AGENT_A["Agent 'cortana'"]
            LA["🔒 Local Bus<br/>max_queue_size: 1000"]:::localbus
            LA1["llm:call_started/ended<br/>llm_error"]:::local
            LA2["tool:dispatched<br/>tool:completed/failed"]:::local
            LA3["agent:reply_stream_*<br/>agent:reply_chunk"]:::local
            LA4["agent:token_used<br/>agent:history_compressed"]:::local
            LA5["WorkSystem<br/>work.* internal events"]:::local
            LA6["AgentIdleManager<br/>idle.system + idle.cycle_completed<br/>idle.inspiration + agent:cold_start_done"]:::local
            LA --> LA1
            LA --> LA2
            LA --> LA3
            LA --> LA4
            LA --> LA5
            LA --> LA6
        end
        subgraph AGENT_B["Agent 'coder'"]
            LB["🔒 Local Bus<br/>max_queue_size: 1000"]:::localbus
            LB1["llm:call_started/ended<br/>llm_error"]:::local
            LB2["tool:dispatched<br/>tool:completed/failed"]:::local
            LB3["agent:reply_stream_*<br/>agent:reply_chunk"]:::local
            LB4["agent:token_used<br/>agent:history_compressed"]:::local
            LB5["WorkSystem<br/>work.* internal events"]:::local
            LB6["AgentIdleManager<br/>idle.system + idle.cycle_completed<br/>idle.inspiration + agent:cold_start_done"]:::local
            LB --> LB1
            LB --> LB2
            LB --> LB3
            LB --> LB4
            LB --> LB5
            LB --> LB6
        end
    end

    subgraph EXTERNAL["External / Frontend"]
        direction LR
        E1["Tauri Frontend<br/>(metrics:updated, event:processed)"]:::frontend
        E2["HTTP API<br/>(/events/recent, /events/trace)"]:::frontend
