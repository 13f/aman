%% ============================================================================
%% 3. Event Flow: Source → Bus → Subscriber → Store
%% ============================================================================

sequenceDiagram
    autonumber

    actor User
    participant Source as Source<br/>(ChatPlatform, Timer, etc.)
    participant Global as Global Bus<br/>(InMemoryBus|PersistentBus)
    participant Registry as AgentRegistry
    participant Local as Agent Local Bus<br/>(InMemoryBus)
    participant Store as StoreAllEvents<br/>Handler → EventStore
    participant Skill as SkillEvent<br/>Dispatcher
    participant Harness as AgentHarness<br/>(ReAct Loop)
    participant Engine as LlmCognitiveEngine
    participant Executor as ToolExecutor
    participant Frontend as Frontend<br/>(Tauri / HTTP)

    rect rgb(227, 242, 253)
        Note over Source,Global: Phase 1: Source → Global Bus
        Source->>Source: poll() / receive message
        Source->>Global: publish(MessageReceived)
        Global->>Store: record to EventStore
        Global->>Skill: dispatch to matching skills
        Skill-->>Global: publish(message:dispatch)
        Skill-->>Global: publish(message:completed)
    end

    rect rgb(252, 228, 236)
        Note over Global,Frontend: Phase 2: MessageReceivedHandler → AgentHarness
        Global->>Harness: handle(MessageReceived)
        Harness->>Registry: resolve_first_enabled_agent()
        Registry-->>Harness: AgentInstance
        Harness->>Global: publish(agent:busy)
        Harness->>Harness: spawn_process_message(agent_id, session_id, text)
    end

    rect rgb(255, 243, 224)
        Note over Harness,Executor: Phase 3: ReAct Loop (think-act-observe)
        loop ReAct Turn
            Harness->>Engine: execute_turn(ctx, messages)
            Engine->>Local: publish(llm:call_started)
            Engine->>Engine: llm_provider.chat_completion()
            Engine->>Local: publish(llm:call_ended)
            Engine-->>Harness: ReActTurn::Finished | ToolCalls

            alt LLM returned Tool Calls
                Harness->>Local: publish(agent:got_tool_calls)
                Harness->>Executor: execute_tools()
                loop Each Tool Call
                    Executor->>Local: publish(tool:dispatched)
                    Executor->>Executor: tool.execute() + security checks
                    Executor->>Local: publish(tool:completed|failed)
                end
                Harness->>Local: publish(agent:tool_results_fed_back)
            else LLM returned Final Response
                Harness->>Global: publish(agent:reply_ready)
                Harness->>Global: publish(agent:idle)
            end
        end
    end

    rect rgb(243, 229, 245)
        Note over Local,Frontend: Phase 4: Streaming (parallel task, Local Bus)
        par Stream Forwarder
            Harness->>Local: publish(agent:reply_stream_start)
            loop Each Chunk
                Harness->>Local: publish(agent:reply_chunk)
            end
            Harness->>Local: publish(agent:reply_stream_done)
        end
    end

    rect rgb(232, 245, 233)
        Note over Global,Frontend: Phase 5: Frontend Delivery
        Frontend->>Global: poll GET /events/recent
        Global-->>Frontend: recent events (from EventStore on Global Bus)
    end

